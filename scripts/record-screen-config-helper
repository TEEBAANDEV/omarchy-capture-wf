#!/bin/bash
# record-screen-config-helper: helper script for Omarchy Screen Recording & Clip UI.

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-screenrecorder/config.sh"

if [[ ! -f $CONFIG_FILE ]]; then
  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat <<'EOF' > "$CONFIG_FILE"
CLIP_DURATION=30
CLIP_DIR="$HOME/Videos/Clips"
REC_FPS=60
REC_CRF=20
REC_PRESET="veryfast"
REC_AUDIO_MODE="both"
CLIP_HOTKEY="SUPER + F10"
EOF
fi

source "$CONFIG_FILE"

RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
BUFFER_PID_FILE="$RUNTIME/record-screen-clip-daemon.pid"
REC_PID_FILE="$RUNTIME/record-screen-daemon.pid"

ACTION="${1:-json}"

case "$ACTION" in
  set)
    KEY="$2"
    VAL="$3"
    if [[ -n $KEY && -n $VAL ]]; then
      if grep -q "^${KEY}=" "$CONFIG_FILE"; then
        sed -i "s|^${KEY}=.*|${KEY}=\"${VAL}\"|" "$CONFIG_FILE"
      else
        echo "${KEY}=\"${VAL}\"" >> "$CONFIG_FILE"
      fi
      if [[ -f $BUFFER_PID_FILE ]] && kill -0 "$(cat "$BUFFER_PID_FILE")" 2>/dev/null; then
        record-screen-clip-daemon stop >/dev/null 2>&1 || true
        sleep 0.5
        record-screen-clip-daemon start >/dev/null 2>&1 &
      fi
    fi
    exit 0
    ;;
  json)
    BUFFER_RUNNING=false
    if [[ -f $BUFFER_PID_FILE ]] && kill -0 "$(cat "$BUFFER_PID_FILE")" 2>/dev/null; then
      BUFFER_RUNNING=true
    fi

    REC_RUNNING=false
    if [[ -f $REC_PID_FILE ]] && kill -0 "$(cat "$REC_PID_FILE")" 2>/dev/null; then
      REC_RUNNING=true
    fi

    cat <<EOF
{
  "clipDuration": "${CLIP_DURATION:-30}",
  "recFps": "${REC_FPS:-60}",
  "recAudioMode": "${REC_AUDIO_MODE:-both}",
  "recCrf": "${REC_CRF:-20}",
  "recPreset": "${REC_PRESET:-veryfast}",
  "clipHotkey": "${CLIP_HOTKEY:-SUPER + F10}",
  "bufferRunning": $BUFFER_RUNNING,
  "recording": $REC_RUNNING,
  "clipDir": "${CLIP_DIR:-$HOME/Videos/Clips}"
}
EOF
    exit 0
    ;;
esac
