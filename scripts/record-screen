#!/bin/bash
# record-screen: toggle screen recording with configurable audio mode.
#
# Video is captured by wf-recorder (CPU x264). Audio mode (both, desktop, mic,
# none) is read from ~/.config/omarchy-screenrecorder/config.sh unless
# overridden via --audio.

set -e

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-screenrecorder/config.sh"
if [[ -f $CONFIG_FILE ]]; then
  source "$CONFIG_FILE"
fi

REGION_MODE=0
AUDIO_MODE="${REC_AUDIO_MODE:-both}"

while [[ $# -gt 0 ]]; do
  case $1 in
    --region) REGION_MODE=1 ;;
    --audio) AUDIO_MODE=${2:-$AUDIO_MODE}; shift ;;
    --daemon) exec "$HOME/.local/bin/record-screen-daemon" --audio "$AUDIO_MODE" --region "$REGION_MODE" ;;
  esac
  shift
done

OUTPUT_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
DAEMON_PID="$RUNTIME/record-screen-daemon.pid"

# Stop path: signal the daemon if it is running.
if [[ -f $DAEMON_PID ]] && kill -0 "$(cat "$DAEMON_PID")" 2>/dev/null; then
  pkill -INT -x wf-recorder 2>/dev/null || true
  exit 0
fi

# Nothing running: start a fresh daemon in its own session.
nohup "$HOME/.local/bin/record-screen-daemon" \
  --audio "$AUDIO_MODE" --region "$REGION_MODE" \
  >"$RUNTIME/record-screen-daemon.log" 2>&1 &
disown
exit 0
