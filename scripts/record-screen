#!/bin/bash
# record-screen: toggle screen recording with MULTI-TRACK audio.
#
# Video is captured by wf-recorder (CPU x264, never touches the RX 580 VCE
# encoder that makes gpu-screen-recorder crash). Audio is captured separately
# by ffmpeg, one track per source (desktop / mic), and the tracks are muxed
# with the video into a single MKV on stop. This replaces the fragile
# PipeWire loopback mixing that only captured the mic at times.
#
# Usage:
#   record-screen [--region] [--audio none|desktop|mic|both]
#
# As a toggle: start recording, or stop the running one.

set -e

REGION_MODE=0
AUDIO_MODE=both
while [[ $# -gt 0 ]]; do
  case $1 in
    --region) REGION_MODE=1 ;;
    --audio) AUDIO_MODE=${2:-both}; shift ;;
    --daemon) exec "$HOME/.local/bin/record-screen-daemon" --audio "$AUDIO_MODE" --region "$REGION_MODE" ;;
  esac
  shift
done

OUTPUT_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
DAEMON_PID="$RUNTIME/record-screen-daemon.pid"

# Stop path: signal the daemon if it is running.
if [[ -f $DAEMON_PID ]] && kill -0 "$(cat "$DAEMON_PID")" 2>/dev/null; then
  pkill -INT -x wf-recorder 2>/dev/null || true
  omarchy-notification-send -t 5000 "Recording saved" "Look in $OUTPUT_DIR"
  exit 0
fi

# Nothing running: start a fresh daemon in its own session.
nohup "$HOME/.local/bin/record-screen-daemon" \
  --audio "$AUDIO_MODE" --region "$REGION_MODE" \
  >"$RUNTIME/record-screen-daemon.log" 2>&1 &
disown
exit 0
