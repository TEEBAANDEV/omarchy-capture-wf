#!/bin/bash
# record-screen-daemon: performs the actual recording.
#
# Spawned by record-screen in its own session. Captures video with wf-recorder
# and audio (multi-track) with ffmpeg, then muxes them into one MKV when the
# video recording is interrupted.

set -e

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-screenrecorder/config.sh"
if [[ -f $CONFIG_FILE ]]; then
  source "$CONFIG_FILE"
fi

AUDIO_MODE="${REC_AUDIO_MODE:-both}"
REGION_MODE=0
while [[ $# -gt 0 ]]; do
  case $1 in
    --audio) AUDIO_MODE=${2:-$AUDIO_MODE}; shift ;;
    --region) REGION_MODE=${2:-0}; shift ;;
  esac
  shift
done

OUTPUT_DIR="${XDG_VIDEOS_DIR:-$HOME/Videos}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"

# Audio endpoints
DESK_SOURCE="${RECORD_DESK_SOURCE:-$(pactl get-default-sink 2>/dev/null).monitor}"
MIC_SOURCE="${RECORD_MIC_SOURCE:-}"
if [[ -z $MIC_SOURCE ]]; then
  MIC_SOURCE="$(pactl get-default-source 2>/dev/null)"
  if [[ $MIC_SOURCE == *.monitor ]]; then
    MIC_SOURCE="$(pactl list short sources 2>/dev/null | awk '$2 !~ /\.monitor$/ {print $2; exit}')"
  fi
fi

mkdir -p "$OUTPUT_DIR"
FINAL="$OUTPUT_DIR/rec-$(date +'%Y-%m-%d_%H-%M-%S').mkv"
VIDEO_TMP="$RUNTIME/record-screen-video.mkv"
AUDIO_TMP="$RUNTIME/record-screen-audio.mkv"

rm -f "$VIDEO_TMP" "$AUDIO_TMP"
echo $$ > "$RUNTIME/record-screen-daemon.pid"

cleanup() {
  rm -f "$RUNTIME/record-screen-daemon.pid"
  rm -f "$VIDEO_TMP" "$AUDIO_TMP"
}
trap cleanup EXIT

# Detect target output or region
WF_TARGET_ARG=()
LOG_TARGET=""
if [[ $REGION_MODE == 1 ]]; then
  GEOS=$(hyprctl monitors -j | jq -r '.[] | "\(.x),\(.y) \(.width)x\(.height)"')
  GEOS+=$'\n'
  WS_LIST=$(hyprctl monitors -j | jq -r '.[] | .activeWorkspace.id' | paste -sd, -)
  GEOS+=$(hyprctl clients -j | jq -r --arg ws "$WS_LIST" '[.[] | select(.mapped == true and .hidden != true and (.workspace.id as $w | $ws | split(",") | map(tonumber) | index($w) != null)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"] | unique[]')
  hyprpicker -r -z >/dev/null 2>&1 &
  FREEZE_PID=$!
  sleep .1
  if ! GEO=$(echo "$GEOS" | slurp -r 2>/dev/null); then
    GEO=""
  fi
  kill "$FREEZE_PID" 2>/dev/null || true
  if [[ -z $GEO ]]; then
    echo "Region pick cancelled" >&2
    exit 1
  fi
  WF_TARGET_ARG=(-g "$GEO")
  LOG_TARGET="Zona ($GEO)"
else
  MON_NAME=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused==true) | .name' | head -1)
  if [[ -n $MON_NAME ]]; then
    WF_TARGET_ARG=(-o "$MON_NAME")
    LOG_TARGET="Pantalla ($MON_NAME)"
  else
    GEO=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused==true) | "\(.x),\(.y) \(.width)x\(.height)"' | head -1)
    [[ -z $GEO ]] && GEO="0,0 1600x900"
    WF_TARGET_ARG=(-g "$GEO")
    LOG_TARGET="Geometría ($GEO)"
  fi
fi

AINFO="no audio"
case $AUDIO_MODE in
  desktop) AINFO="desktop audio (1 track)" ;;
  mic)     AINFO="microphone audio (1 track)" ;;
  both)    AINFO="3 audio tracks: Track 1=Mix, Track 2=Desktop, Track 3=Microphone" ;;
esac

REC_FPS="${REC_FPS:-60}"
REC_CRF="${REC_CRF:-20}"
REC_PRESET="${REC_PRESET:-veryfast}"

wf-recorder "${WF_TARGET_ARG[@]}" -r "$REC_FPS" -c libx264 -p preset="$REC_PRESET" -p crf="$REC_CRF" \
  -f "$VIDEO_TMP" >"/dev/null" 2>&1 &
WFPID=$!

FFPID=""
if [[ $AUDIO_MODE != none ]]; then
  FF_ARGS=(-y)
  case $AUDIO_MODE in
    desktop)
      FF_ARGS+=( -f pulse -i "$DESK_SOURCE" )
      MAP_ARGS=(-map 0:a:0)
      ;;
    mic)
      FF_ARGS+=( -f pulse -i "$MIC_SOURCE" )
      MAP_ARGS=(-filter_complex "[0:a]pan=stereo|c0=c0|c1=c0[mix]" -map "[mix]")
      ;;
    both)
      FF_ARGS+=( -f pulse -i "$DESK_SOURCE" -f pulse -i "$MIC_SOURCE" )
      MIX_FILTER="[0:a]aformat=sample_rates=48000,pan=stereo|c0=c0|c1=c0,asplit=2[deskP][deskM];[1:a]aformat=sample_rates=48000,pan=stereo|c0=c0|c1=c0,asplit=2[micP][micM];[deskM][micM]amix=inputs=2:duration=longest:normalize=0[mix]"
      MAP_ARGS=(-filter_complex "$MIX_FILTER" -map "[mix]" -map "[deskP]" -map "[micP]")
      ;;
  esac
  ffmpeg "${FF_ARGS[@]}" "${MAP_ARGS[@]}" \
    -c:a aac -ac 2 "$AUDIO_TMP" >/dev/null 2>&1 &
  FFPID=$!
fi

omarchy-notification-send -t 3000 "Recording started" "$LOG_TARGET @ ${REC_FPS}fps ($AINFO)"

sleep 3
if ! kill -0 "$WFPID" 2>/dev/null; then
  [[ -n $FFPID ]] && kill "$FFPID" 2>/dev/null || true
  echo "recording failed" >&2
  omarchy-notification-send -u critical -t 5000 "Recording failed" "wf-recorder could not start"
  exit 1
fi

while kill -0 "$WFPID" 2>/dev/null; do
  sleep 1
done

if [[ -n $FFPID ]] && kill -0 "$FFPID" 2>/dev/null; then
  kill -INT "$FFPID" 2>/dev/null || true
  for _ in $(seq 1 20); do
    kill -0 "$FFPID" 2>/dev/null || break
    sleep 0.2
  done
  kill "$FFPID" 2>/dev/null || true
fi
sleep 0.5

if [[ $AUDIO_MODE == none ]]; then
  mv "$VIDEO_TMP" "$FINAL"
else
  case $AUDIO_MODE in
    desktop) TRACK_TITLES=(-metadata:s:a:0 "title=Desktop") ;;
    mic)     TRACK_TITLES=(-metadata:s:a:0 "title=Microphone") ;;
    both)    TRACK_TITLES=(-metadata:s:a:0 "title=Mix" -metadata:s:a:1 "title=Desktop" -metadata:s:a:2 "title=Microphone") ;;
  esac
  ffmpeg -y -i "$VIDEO_TMP" -i "$AUDIO_TMP" \
    -map 0:v:0 -map 1:a -c copy "${TRACK_TITLES[@]}" "$FINAL" \
    >/dev/null 2>&1 || {
      echo "mux failed, keeping separables" >&2
      mv "$VIDEO_TMP" "${FINAL%.mkv}.video.mkv"
      mv "$AUDIO_TMP" "${FINAL%.mkv}.audio.mkv"
    }
fi

exit 0
